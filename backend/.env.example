# ============================================================
# ALFAMART POS - Environment Configuration
# Salin file ini menjadi .env dan sesuaikan nilainya
# ============================================================

# Server
PORT=4000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=alfamart_pos

# App Config
STORE_NAME=Alfamart Sudirman 01
STORE_ADDRESS=Jl. Jend. Sudirman No.1, Jakarta Pusat
STORE_PHONE=(021) 555-0101
TAX_RATE=0.11

# Telegram (opsional): buat bot melalui @BotFather, lalu simpan token di sini.
# TELEGRAM_DEFAULT_CHAT_ID dipakai bila kasir tidak memasukkan Chat ID pelanggan.
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# WhatsApp Cloud API Meta (opsional). Nomor tujuan menggunakan format E.164
# tanpa tanda +, misalnya 628123456789.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_DEFAULT_TO=
# Opsional tetapi dianjurkan: utility template Meta dengan tepat satu
# placeholder body {{1}} untuk ringkasan struk.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=id
